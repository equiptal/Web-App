<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8" />
<title>My Suppliers — Moedatech</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&display=swap"
  rel="stylesheet"
/>

<!--
  Moedatech — MY SUPPLIERS · v1

  The renter's own supplier repository, and the email invitation that goes out from it.

  THE MODEL, in one paragraph. A row here is a LINK between this renter and a supplier — never a
  field on the supplier's own account. The same supplier can be a registered vendor for one renter
  and not for another, so `vendorRegistered` lives on the link and nowhere else. A link is either
  `platform` (it points at a Moedatech supplier and reads that supplier's name and store live) or
  `own` (the renter typed it or imported it from a sheet, so the row carries the name and contact
  itself). The join key between the two worlds is the phone number in E.164 — the same key the
  off-platform link bids already use.

  WHAT THIS IS NOT. It is not the app's supplier directory. Stores is that, and Stores looks the
  same for every renter. This list starts empty and only ever holds rows the renter created.
  Browsing all suppliers is an action inside this screen, not the screen itself.

  SCOPE. Email only. A group invitation is one server-sent email to the selected recipients, so
  every recipient needs an email address and the screen has to say who is missing one before the
  send. WhatsApp is deliberately out: `wa.me` addresses exactly one number, and true bulk sending
  needs the WhatsApp Business Cloud API with an approved template.

  It matches the app: `RenterSupplier` in src/lib/api/client.ts:1217, `GET /api/renter-suppliers`,
  the share sheet in src/components/requests/ShareForBidsSheet.tsx, and the link preview built by
  src/app/bid/[token]/page.tsx. The writes it needs do not exist yet.

  Demo data throughout. TODAY is pinned so "3 days ago" stays honest.
-->

<style>
  :root{
    --navy-deep:#16263f; --navy:#1c3550; --navy-mid:#2a4f72;
    --muted-dark:#5a6b82; --muted:#6b8fa8; --muted-light:#9aa7b8;
    --border-strong:#c3d2e0; --border:#d4e0ec;
    --surface3:#e4edf5; --surface2:#eff4f9; --background:#f5f8fc; --surface:#ffffff;
    --brand:#f79009; --brand-hover:#e58108; --brand-press:#cc7207;
    --brand-deep:#b45309; --brand-pale:#fde8cc; --brand-soft:#fff4e5;
    --ok:#1daf58; --ok-soft:#e7f7ee; --ok-deep:#15803d;
    --warn:#d4780a; --warn-soft:#fff3e0; --warn-deep:#8a4f08;
    --danger:#d9362a; --danger-soft:#fcebea; --danger-deep:#b03636;
    --info:#1a7ec8; --info-soft:#e6f2fb; --info-deep:#0e4f7e;
    --t-label:11px; --t-meta:12.5px; --t-body:13px; --t-subhead:15px; --t-title:17px; --t-display:22px;
    --r-sm:2px; --r-md:4px; --r-lg:6px; --r-full:999px;
    --c-sm:30px; --c-md:34px; --c-lg:44px;
    --t:150ms cubic-bezier(.32,.72,.24,1);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--background);color:var(--navy);
    font-family:"Nunito",-apple-system,"Segoe UI",Roboto,sans-serif;
    font-size:var(--t-body);line-height:1.5;-webkit-font-smoothing:antialiased}
  [dir="rtl"] body{font-family:"IBM Plex Sans Arabic","Nunito",sans-serif}
  button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
  input,select,textarea{font:inherit;color:inherit}
  a{color:inherit;text-decoration:none}
  h1,h2,h3,h4{margin:0;line-height:1.25;font-weight:800;letter-spacing:-.02em}
  p{margin:0}
  ::selection{background:var(--brand-pale);color:var(--navy)}
  .icon{font-family:"Material Symbols Rounded";line-height:1;display:inline-block;direction:ltr;
    -webkit-font-feature-settings:"liga";user-select:none;font-variation-settings:"opsz" 24,"wght" 400,"FILL" 0}
  .num{font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums}
  .ltr{direction:ltr;unicode-bidi:isolate;display:inline-block}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  :focus-visible{outline:2px solid var(--brand);outline-offset:2px}
  @media (prefers-reduced-motion:reduce){ *,*::before,*::after{transition:none !important} }

  .wrap{max-width:1560px;margin:0 auto;padding:0 16px}
  @media (min-width:640px){ .wrap{padding:0 24px} }
  @media (min-width:1280px){ .wrap{padding:0 32px} }

  /* ── app bar ────────────────────────────────────────────────────────────── */
  .appbar{position:sticky;top:0;z-index:40;height:62px;background:var(--navy);color:#fff;
    display:flex;align-items:center;padding:0 24px;gap:18px}
  .wordmark{display:flex;align-items:center;gap:8px;font-weight:800;font-size:var(--t-title)}
  .wordmark .m{width:var(--c-sm);height:var(--c-sm);border-radius:var(--r-sm);background:#fff;color:var(--navy);
    display:grid;place-items:center;font-size:var(--t-title)}
  .navslot ul{display:flex;gap:4px;list-style:none;margin:0;padding:0}
  .navtab{display:inline-flex;align-items:center;height:var(--c-md);border-radius:var(--r-full);padding:0 16px;
    font-size:var(--t-body);font-weight:600;color:rgba(255,255,255,.72);transition:background var(--t),color var(--t)}
  .navtab:hover{background:rgba(255,255,255,.1);color:#fff}
  .navtab[aria-current="page"]{background:#fff;color:var(--navy);font-weight:800}
  .barright{margin-inline-start:auto;display:flex;align-items:center;gap:10px}
  .langbtn{height:var(--c-sm);border-radius:var(--r-full);padding:0 12px;font-size:var(--t-meta);font-weight:800;
    border:1px solid rgba(255,255,255,.35);color:#fff;transition:background var(--t)}
  .langbtn:hover{background:rgba(255,255,255,.12)}

  /* ── section scaffolding ────────────────────────────────────────────────── */
  .sec{padding:20px 0 40px}
  .shead{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .shead .plate{width:38px;height:38px;flex:none;background:var(--navy);color:#fff;
    display:grid;place-items:center;border-radius:var(--r-sm)}
  .shead .plate .icon{font-size:var(--t-display)}
  .shead .txt{min-width:0}
  .shead h2{font-size:var(--t-title)}
  .shead .sum{display:block;color:var(--muted);font-size:var(--t-meta);margin-top:2px}
  .shead .sum b{color:var(--navy);font-weight:800}
  .shead .sum .risk{color:var(--danger-deep);font-weight:800}
  .shead .spacer{flex:1}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:var(--c-md);
    border-radius:var(--r-md);padding:0 14px;font-size:var(--t-body);font-weight:700;
    transition:background var(--t),border-color var(--t),color var(--t)}
  .btn .icon{font-size:var(--t-subhead)}
  .btn-primary{background:var(--brand);color:#fff}
  .btn-primary:hover{background:var(--brand-hover)}
  .btn-secondary{background:var(--surface);border:1px solid var(--border-strong);color:var(--navy)}
  .btn-secondary:hover{background:var(--surface2);border-color:var(--navy-mid)}
  .btn-ghost{color:var(--navy);border:1px solid transparent}
  .btn-ghost:hover{background:var(--surface2)}
  .btn-danger{background:var(--danger);color:#fff}
  .btn-danger:hover{background:var(--danger-deep)}
  .btn-sm{height:var(--c-sm);padding:0 11px;font-size:var(--t-meta)}
  .btn[disabled]{opacity:.45;cursor:not-allowed}

  .panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md)}

  /* ── the suggested band ─────────────────────────────────────────────────────
     Suppliers who already bid on this renter's requests but hold no link row yet. It is a
     suggestion, never an automatic insert: the renter decides who belongs in the repository. */
  .sugg{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:9px 12px;margin-bottom:10px;
    background:var(--info-soft);border:1px solid #bfdcf3;border-radius:var(--r-md);font-size:var(--t-meta)}
  .sugg .icon{font-size:var(--t-subhead);color:var(--info-deep)}
  .sugg b{font-weight:800}
  .sugg .sgrow{display:flex;gap:6px;flex-wrap:wrap}
  .sgchip{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 6px 0 10px;border-radius:var(--r-full);
    background:var(--surface);border:1px solid #bfdcf3;font-weight:700;font-size:var(--t-meta)}
  .sgchip .add{width:20px;height:20px;border-radius:var(--r-full);display:grid;place-items:center;
    background:var(--info);color:#fff}
  .sgchip .add .icon{font-size:13px;color:#fff}
  .sugg .dismiss{margin-inline-start:auto;color:var(--info-deep);font-weight:700}

  /* ── toolbar ────────────────────────────────────────────────────────────── */
  .tbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 12px;border-bottom:1px solid var(--border)}
  .search{display:flex;align-items:center;gap:7px;height:var(--c-sm);min-width:230px;padding:0 10px;
    background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-md)}
  .search .icon{font-size:var(--t-subhead);color:var(--muted)}
  .search input{border:0;background:transparent;outline:none;width:100%;font-size:var(--t-meta);font-weight:600}
  .fchip{display:inline-flex;align-items:center;gap:6px;height:var(--c-sm);border-radius:var(--r-full);padding:0 12px;
    background:var(--surface);border:1px solid var(--border);font-size:var(--t-meta);font-weight:700;color:var(--muted-dark);
    transition:background var(--t),border-color var(--t),color var(--t)}
  .fchip:hover{border-color:var(--navy-mid);color:var(--navy)}
  .fchip[aria-pressed="true"]{background:var(--navy);border-color:var(--navy);color:#fff}
  .fchip .n{font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums;opacity:.75}
  .fchip .icon{font-size:var(--t-body)}
  .fchip.warnish[aria-pressed="true"]{background:var(--danger);border-color:var(--danger)}
  .tbar .spacer{flex:1}
  .gsel{height:var(--c-sm);border:1px solid var(--border);border-radius:var(--r-md);background:var(--surface);
    padding:0 8px;font-size:var(--t-meta);font-weight:700}

  /* ── selection bar ──────────────────────────────────────────────────────── */
  .selbar{display:none;align-items:center;gap:10px;flex-wrap:wrap;padding:9px 12px;
    background:var(--navy);color:#fff;font-size:var(--t-meta);font-weight:700}
  .selbar.on{display:flex}
  .selbar .spacer{flex:1}
  .selbar .btn-secondary{background:transparent;border-color:rgba(255,255,255,.4);color:#fff}
  .selbar .btn-secondary:hover{background:rgba(255,255,255,.12);border-color:#fff}
  .selbar .clear{color:rgba(255,255,255,.75);font-weight:700}
  .selbar .clear:hover{color:#fff}

  /* ── the table ──────────────────────────────────────────────────────────── */
  table{width:100%;border-collapse:collapse}
  thead th{text-align:start;font-size:var(--t-label);font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:var(--muted);padding:8px 12px;border-bottom:1px solid var(--border);background:var(--surface2);
    white-space:nowrap}
  tbody td{padding:9px 12px;border-bottom:1px solid var(--border);vertical-align:middle}
  tbody tr:last-child td{border-bottom:0}
  tbody tr:hover{background:var(--surface2)}
  tbody tr.picked{background:var(--brand-soft)}
  tbody tr.picked:hover{background:var(--brand-pale)}
  .cbox{width:34px}
  .cbox input{width:15px;height:15px;accent-color:var(--brand)}

  .sname{display:flex;align-items:center;gap:9px;min-width:0}
  .avatar{width:30px;height:30px;flex:none;border-radius:var(--r-sm);display:grid;place-items:center;
    background:var(--surface3);color:var(--navy-mid);font-weight:800;font-size:var(--t-meta)}
  .avatar.plat{background:var(--navy);color:#fff}
  .sname .n{display:block;font-weight:800;font-size:var(--t-body)}
  .sname .c{display:block;color:var(--muted);font-size:var(--t-meta)}
  .sname .n a{border-bottom:1px solid var(--border-strong)}
  .sname .n a:hover{border-bottom-color:var(--navy)}

  /* Identity chips. They answer four questions in one strip: is this supplier on Moedatech, does
     the renter treat them as a registered vendor, did they bid, and can they be emailed at all. */
  .idset{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
  .idchip{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 8px;border-radius:var(--r-full);
    font-size:var(--t-label);font-weight:800;letter-spacing:.02em;border:1px solid transparent;white-space:nowrap}
  .idchip .icon{font-size:13px}
  .id-plat{background:var(--navy);color:#fff}
  .id-off{background:var(--surface2);color:var(--muted-dark);border-color:var(--border-strong)}
  .id-store{background:var(--info-soft);color:var(--info-deep);border-color:#bfdcf3}
  .id-bid{background:var(--ok-soft);color:var(--ok-deep);border-color:#b9e5cb}
  .id-noemail{background:var(--danger-soft);color:var(--danger-deep);border-color:#f3c9c6}

  /* The vendor flag is a control, not a label — it is the renter's own switch on the link row. */
  .vtog{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:var(--r-full);
    border:1px dashed var(--border-strong);background:var(--surface);color:var(--muted);
    font-size:var(--t-label);font-weight:800;letter-spacing:.02em;transition:var(--t)}
  .vtog:hover{border-color:var(--navy-mid);color:var(--navy)}
  .vtog .icon{font-size:14px}
  .vtog[aria-pressed="true"]{border-style:solid;border-color:var(--ok);background:var(--ok-soft);color:var(--ok-deep)}

  .contact{display:block;font-size:var(--t-meta)}
  .contact .em{display:block;font-weight:700}
  .contact .ph{display:block;color:var(--muted)}
  .contact .missing{color:var(--danger-deep);font-weight:800;display:inline-flex;align-items:center;gap:4px}
  .contact .missing .icon{font-size:13px}
  .contact .addem{color:var(--info-deep);font-weight:800;border-bottom:1px solid #bfdcf3}

  .gchips{display:flex;gap:4px;flex-wrap:wrap}
  .gchip{display:inline-flex;align-items:center;height:20px;padding:0 7px;border-radius:var(--r-full);
    background:var(--surface3);color:var(--navy-mid);font-size:var(--t-label);font-weight:800}
  .gchip.none{background:transparent;color:var(--muted-light);border:1px dashed var(--border-strong)}

  .act{display:block;font-size:var(--t-meta);white-space:nowrap}
  .act .k{color:var(--muted)}
  .act .last{display:block;color:var(--muted-light);font-size:var(--t-label);font-weight:700}
  .act .none{color:var(--muted-light)}

  .rowacts{display:flex;align-items:center;gap:2px;justify-content:flex-end}
  .iact{width:var(--c-sm);height:var(--c-sm);border-radius:var(--r-sm);display:grid;place-items:center;
    color:var(--muted);transition:var(--t)}
  .iact:hover{background:var(--surface3);color:var(--navy)}
  .iact.del:hover{background:var(--danger-soft);color:var(--danger)}
  .iact .icon{font-size:var(--t-subhead)}
  .iact[disabled]{opacity:.3;cursor:not-allowed}

  .empty{padding:34px 16px;text-align:center;color:var(--muted)}
  .empty .icon{font-size:32px;color:var(--muted-light);display:block;margin-bottom:6px}
  .empty b{display:block;color:var(--navy);font-size:var(--t-subhead);margin-bottom:3px}

  /* The legend states what each chip means, once, at the bottom — not on every row. */
  .legend{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:9px 12px;border-top:1px solid var(--border);
    background:var(--surface2);font-size:var(--t-label);color:var(--muted-dark);font-weight:700}
  .legend .li{display:inline-flex;align-items:center;gap:5px}

  /* ── dialogs ────────────────────────────────────────────────────────────── */
  .scrim{position:fixed;inset:0;z-index:60;background:rgba(28,53,80,.45);display:none;
    align-items:center;justify-content:center;padding:20px;overflow:auto}
  .scrim.open{display:flex}
  .modal{width:100%;max-width:620px;background:var(--surface);border-radius:var(--r-lg);overflow:hidden}
  .modal.wide{max-width:860px}
  .mhead{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border)}
  .mhead .plate{width:32px;height:32px;flex:none;border-radius:var(--r-sm);background:var(--brand-soft);
    color:var(--brand-deep);display:grid;place-items:center}
  .mhead h3{font-size:var(--t-subhead)}
  .mhead .sub{display:block;font-size:var(--t-meta);color:var(--muted);font-weight:600}
  .mhead .x{margin-inline-start:auto;width:var(--c-sm);height:var(--c-sm);border-radius:var(--r-sm);
    display:grid;place-items:center;color:var(--muted)}
  .mhead .x:hover{background:var(--surface2);color:var(--navy)}
  .mbody{padding:16px 18px;display:grid;gap:14px;max-height:66vh;overflow-y:auto;overflow-x:hidden}
  .mfoot{display:flex;align-items:center;gap:8px;justify-content:flex-end;padding:12px 18px;
    border-top:1px solid var(--border);background:var(--surface2)}
  .mfoot .spacer{flex:1}
  .mfoot .note{font-size:var(--t-meta);color:var(--muted);font-weight:600}

  .field{display:grid;gap:5px}
  /* Direct child only: a picker row is itself a <label>, and it must not inherit the caption look. */
  .field > label{font-size:var(--t-label);font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .field .req{color:var(--danger)}
  .field input,.field select,.field textarea{height:var(--c-md);border:1px solid var(--border-strong);
    border-radius:var(--r-md);padding:0 10px;font-size:var(--t-body);background:var(--surface)}
  .field textarea{height:auto;padding:8px 10px;line-height:1.5}
  .field input:focus,.field select:focus{outline:2px solid var(--brand);outline-offset:-1px;border-color:var(--brand)}
  .field .hint{font-size:var(--t-meta);color:var(--muted)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media (max-width:560px){ .grid2{grid-template-columns:1fr} }

  .note{display:flex;gap:8px;padding:9px 11px;border-radius:var(--r-md);font-size:var(--t-meta);line-height:1.45}
  .note .icon{font-size:var(--t-subhead);flex:none}
  .note.info{background:var(--info-soft);color:var(--info-deep)}
  .note.warn{background:var(--danger-soft);color:var(--danger-deep)}
  .note.calm{background:var(--surface2);color:var(--muted-dark)}

  /* Picker rows, shared by "add from Moedatech" and the invite recipient list. */
  .plist{border:1px solid var(--border);border-radius:var(--r-md);max-height:300px;overflow:auto}
  .prow{display:flex;align-items:center;gap:10px;padding:8px 11px;border-bottom:1px solid var(--border);
    text-align:start;width:100%}
  .prow:last-child{border-bottom:0}
  .prow:hover{background:var(--surface2)}
  .prow input{width:15px;height:15px;accent-color:var(--brand);flex:none}
  .prow .t{min-width:0;flex:1}
  .prow .t b{display:block;font-size:var(--t-body);font-weight:800}
  .prow .t span{display:block;font-size:var(--t-meta);color:var(--muted)}
  .prow .have{font-size:var(--t-label);font-weight:800;color:var(--ok-deep);
    background:var(--ok-soft);border-radius:var(--r-full);padding:1px 8px}

  /* The sheet import: their header row on the left, our field on the right. */
  .maptbl{width:100%}
  .maptbl th,.maptbl td{padding:7px 10px;font-size:var(--t-meta)}
  .maptbl select{height:var(--c-sm);border:1px solid var(--border-strong);border-radius:var(--r-md);padding:0 8px;
    font-size:var(--t-meta);font-weight:700;background:var(--surface)}
  .maptbl .kept{font-size:var(--t-label);font-weight:800;color:var(--muted-dark);
    background:var(--surface3);border-radius:var(--r-full);padding:1px 8px}
  .prev{border:1px solid var(--border);border-radius:var(--r-md);overflow:auto;max-height:190px}
  .prev td,.prev th{white-space:nowrap;font-size:var(--t-meta);padding:6px 10px}
  .drop{border:1px dashed var(--border-strong);border-radius:var(--r-md);padding:20px;text-align:center;
    color:var(--muted);background:var(--surface2)}
  .drop .icon{font-size:28px;display:block;margin-bottom:4px;color:var(--muted-light)}
  .drop b{color:var(--navy)}

  /* The email preview. Deliberately plain: it is the message the supplier receives. */
  .mail{border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden}
  .mailhead{padding:9px 12px;border-bottom:1px solid var(--border);background:var(--surface2);font-size:var(--t-meta)}
  .mailhead .l{display:flex;gap:8px;padding:1px 0}
  .mailhead .k{width:64px;flex:none;color:var(--muted);font-weight:800;text-transform:uppercase;font-size:var(--t-label);
    letter-spacing:.05em;padding-top:2px}
  .mailhead .v{font-weight:700;min-width:0}
  .mailbody{padding:14px 16px;font-size:var(--t-meta);line-height:1.6;display:grid;gap:11px}
  /* The link card: what WhatsApp, Apple Mail, Outlook and Slack already unfurl today. */
  .lcard{border:1px solid var(--border-strong);border-radius:var(--r-md);overflow:hidden}
  .lcard .top{display:flex;align-items:center;gap:10px;padding:11px 12px;background:var(--navy);color:#fff}
  .lcard .top .plate{width:34px;height:34px;flex:none;border-radius:var(--r-sm);background:rgba(255,255,255,.16);
    display:grid;place-items:center}
  .lcard .top b{display:block;font-size:var(--t-body)}
  .lcard .top span{display:block;font-size:var(--t-label);color:rgba(255,255,255,.75);font-weight:700}
  .lcard .rows{padding:10px 12px;display:grid;gap:5px;background:var(--surface)}
  .lcard .r{display:flex;gap:8px;font-size:var(--t-meta)}
  .lcard .r .k{width:96px;flex:none;color:var(--muted);font-weight:700}
  .lcard .r .v{font-weight:800}
  .lcard .foot{padding:8px 12px;border-top:1px solid var(--border);color:var(--muted);font-size:var(--t-label);
    background:var(--surface2);font-weight:700}
  .cta{display:inline-flex;align-items:center;justify-content:center;height:var(--c-md);border-radius:var(--r-md);
    padding:0 16px;background:var(--brand);color:#fff;font-weight:800;font-size:var(--t-body)}

  /* The supplier sheet — the renter's history with one supplier. */
  .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  @media (max-width:560px){ .kpis{grid-template-columns:repeat(2,1fr)} }
  .kpi{border:1px solid var(--border);border-radius:var(--r-md);padding:9px 11px;background:var(--surface2)}
  .kpi b{display:block;font-size:var(--t-title);font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums}
  .kpi b.words{font-family:inherit;font-size:var(--t-subhead);font-weight:800}
  .kpi span{display:block;font-size:var(--t-label);font-weight:800;text-transform:uppercase;letter-spacing:.05em;
    color:var(--muted)}
  .tl{display:grid;gap:0}
  .tlrow{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);align-items:flex-start}
  .tlrow:last-child{border-bottom:0}
  .tlrow .dot{width:22px;height:22px;flex:none;border-radius:var(--r-full);display:grid;place-items:center;
    background:var(--surface3);color:var(--navy-mid)}
  .tlrow .dot .icon{font-size:13px}
  .tlrow .t{flex:1;min-width:0}
  .tlrow .t b{display:block;font-size:var(--t-body);font-weight:700}
  .tlrow .t span{display:block;font-size:var(--t-meta);color:var(--muted)}
  .tlrow .when{font-size:var(--t-label);color:var(--muted-light);font-weight:700;white-space:nowrap;padding-top:3px}
  .tlrow .go{font-size:var(--t-meta);font-weight:800;color:var(--info-deep)}
  .xtra{display:grid;gap:4px}
  .xtra .x{display:flex;gap:8px;font-size:var(--t-meta);padding:3px 0;border-bottom:1px dashed var(--border)}
  .xtra .x:last-child{border-bottom:0}
  .xtra .x .k{width:150px;flex:none;color:var(--muted);font-weight:700}

  .toast{position:fixed;inset-inline-start:50%;transform:translateX(-50%);bottom:22px;z-index:80;
    background:var(--navy-deep);color:#fff;border-radius:var(--r-md);padding:10px 15px;font-size:var(--t-meta);
    font-weight:700;display:none;align-items:center;gap:8px}
  .toast.on{display:flex}
  .toast .icon{font-size:var(--t-subhead);color:var(--ok)}
</style>
</head>

<body>
<header class="appbar">
  <div class="wordmark"><span class="m icon">handyman</span> moedatech</div>
  <nav class="navslot">
    <ul>
      <li><button class="navtab">Dashboard</button></li>
      <li><button class="navtab">Stores</button></li>
      <li><button class="navtab" aria-current="page">My Suppliers</button></li>
      <li><button class="navtab">My Organization</button></li>
    </ul>
  </nav>
  <div class="barright"><button class="langbtn" id="langbtn" onclick="toggleLang()">العربية</button></div>
</header>

<main class="wrap sec">
  <div id="root"></div>
</main>

<div class="scrim" id="scrim" onclick="if(event.target===this)closeModal()"></div>
<div class="toast" id="toast"></div>

<script>
/* ══ language ═══════════════════════════════════════════════════════════════ */
var ar = false;
function L(en, arr){ return ar ? arr : en; }
function toggleLang(){
  ar = !ar;
  document.documentElement.lang = ar ? "ar" : "en";
  document.documentElement.dir  = ar ? "rtl" : "ltr";
  document.getElementById("langbtn").textContent = ar ? "English" : "العربية";
  render();
}
function esc(s){ return String(s == null ? "" : s).replace(/[&<>"]/g, function(c){
  return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;" }[c]; }); }

var TODAY = new Date("2026-08-31T09:00:00");
function ago(iso){
  if (!iso) return null;
  var days = Math.floor((TODAY - new Date(iso)) / 86400000);
  if (days <= 0) return L("today", "اليوم");
  if (days === 1) return L("yesterday", "أمس");
  if (days < 30) return L(days + " days ago", "قبل " + days + " يوم");
  var m = Math.floor(days / 30);
  return m === 1 ? L("last month", "الشهر الماضي") : L(m + " months ago", "قبل " + m + " أشهر");
}

/* ══ demo data ══════════════════════════════════════════════════════════════
   A row is a LINK between this renter and a supplier.

     kind "platform" — points at a Moedatech account. `name` and `store` are read live from that
                       account, so a rename there follows through here. Nothing is copied.
     kind "own"      — typed by the renter or imported from a sheet. The row carries the name and
                       the contact itself, because there is no account to read.

   `vendor` is the renter's own flag and lives ONLY here. It is never a column on the supplier's
   account: the same supplier is a registered vendor for one renter and not for another.

   `activity` is derived, not stored — bids received, deal rooms opened, awards made. It comes from
   the reads the app already has (`/me/received-bids`, `/me/deal-rooms`, the link submissions),
   joined by supplier id for platform rows and by phone in E.164 for own rows.                     */

var SUPPLIERS = [
  { id:"l1", kind:"platform", supplierId:"u_882", store:true,
    nEn:"Zahid Tractor", nAr:"زاهد للجرارات", contact:"Faisal Al-Otaibi",
    email:"tenders@zahidtractor.com", phone:"+966 55 214 8890",
    vendor:true, groups:["Earthmoving","Riyadh"], source:"platform",
    activity:{ bids:12, rooms:3, awards:2, last:"2026-08-29" },
    events:[
      { icon:"gavel",     t:"Bid received — Excavator 20t",      s:"8,400 SAR/mo · Qiddiya Zone 4", when:"2026-08-29", go:true },
      { icon:"forum",     t:"Deal room opened",                  s:"Qiddiya Zone 4 · 5 units",      when:"2026-08-29", go:true },
      { icon:"mail",      t:"Invited by email",                  s:"Excavator 20t — opened",        when:"2026-08-26" },
      { icon:"workspace_premium", t:"Awarded — Manlift 16m",     s:"2 of 4 units · Diriyah Gate",   when:"2026-07-14", go:true }
    ] },

  { id:"l2", kind:"platform", supplierId:"u_419", store:false,
    nEn:"Al-Rajhi Equipment", nAr:"الراجحي للمعدات", contact:"Mohammed Al-Rajhi",
    email:"bids@alrajhi-eq.sa", phone:"+966 50 771 2043",
    vendor:true, groups:["Earthmoving"], source:"platform",
    activity:{ bids:7, rooms:2, awards:1, last:"2026-08-24" },
    events:[
      { icon:"gavel", t:"Bid received — Excavator 20t", s:"8,950 SAR/mo · Qiddiya Zone 4", when:"2026-08-24", go:true },
      { icon:"mail",  t:"Invited by email",             s:"Excavator 20t — opened",        when:"2026-08-22" }
    ] },

  { id:"l3", kind:"platform", supplierId:"u_733", store:true,
    nEn:"Nesma Rentals", nAr:"نسما للتأجير", contact:"Sara Bin Mahfouz",
    email:null, phone:"+966 53 908 4417",
    vendor:false, groups:["Lifting"], source:"platform",
    activity:{ bids:4, rooms:1, awards:0, last:"2026-08-18" },
    events:[
      { icon:"gavel", t:"Bid received — Tower crane 8t", s:"46,000 SAR/mo · King Khalid Airport", when:"2026-08-18", go:true }
    ] },

  { id:"l4", kind:"own", supplierId:null, store:false,
    nEn:"Desert Fleet Co.", nAr:"أسطول الصحراء", contact:"Turki Al-Harbi",
    email:"ops@desertfleet.sa", phone:"+966 56 330 1180",
    vendor:true, groups:["Riyadh"], source:"manual",
    activity:{ bids:1, rooms:0, awards:0, last:"2026-08-27", viaLink:true },
    events:[
      { icon:"link", t:"Bid submitted through your shared link", s:"Generator 250 kVA · Aramco — Dhahran", when:"2026-08-27", go:true },
      { icon:"mail", t:"Invited by email",                       s:"Generator 250 kVA — opened",          when:"2026-08-25" }
    ] },

  { id:"l5", kind:"own", supplierId:null, store:false,
    nEn:"Hail Heavy Transport", nAr:"حائل للنقل الثقيل", contact:"Nayef Al-Shammari",
    email:null, phone:"+966 54 662 7301",
    vendor:false, groups:["Transport"], source:"sheet",
    extra:{ "CR number":"1010884213", "Payment terms":"30 days", "Account manager":"Nayef" },
    activity:{ bids:0, rooms:0, awards:0, last:null },
    events:[] },

  { id:"l6", kind:"own", supplierId:null, store:false,
    nEn:"Gulf Power Rentals", nAr:"الخليج لتأجير المولدات", contact:"Ahmed Siddiqui",
    email:"quotes@gulfpower.com.sa", phone:"+966 59 118 5502",
    vendor:true, groups:["Power"], source:"sheet",
    extra:{ "CR number":"2050119887", "Payment terms":"45 days", "Account manager":"Ahmed" },
    activity:{ bids:2, rooms:0, awards:0, last:"2026-08-20", viaLink:true },
    events:[
      { icon:"link", t:"Bid submitted through your shared link", s:"Generator 250 kVA · Aramco — Dhahran", when:"2026-08-20", go:true }
    ] }
];

/* Suppliers who bid on this renter's requests but hold no link row yet. A suggestion, never an
   automatic insert. */
var SUGGESTED = [
  { key:"g1", nEn:"Arabian Crane Services", nAr:"الخليج العربي للرافعات", why:"bid 3 days ago",
    whyAr:"قدّم عرضاً قبل 3 أيام", kind:"own", phone:"+966 55 447 2216", email:null },
  { key:"g2", nEn:"Saudi Lift Co.", nAr:"السعودية للرفع", why:"bid last week", whyAr:"قدّم عرضاً الأسبوع الماضي",
    kind:"platform", supplierId:"u_951", phone:"+966 50 220 9964", email:"info@saudilift.sa" }
];
var suggOpen = true;

/* The app's supplier directory, as the picker sees it. Stores owns this list; the picker only reads
   it and writes a link row per tick. */
var DIRECTORY = [
  { supplierId:"u_882", nEn:"Zahid Tractor",           nAr:"زاهد للجرارات",        city:"Riyadh",  store:true,  eq:41 },
  { supplierId:"u_419", nEn:"Al-Rajhi Equipment",      nAr:"الراجحي للمعدات",      city:"Riyadh",  store:false, eq:18 },
  { supplierId:"u_733", nEn:"Nesma Rentals",           nAr:"نسما للتأجير",         city:"Jeddah",  store:true,  eq:27 },
  { supplierId:"u_951", nEn:"Saudi Lift Co.",          nAr:"السعودية للرفع",       city:"Dammam",  store:true,  eq:12 },
  { supplierId:"u_604", nEn:"Binladin Plant Hire",     nAr:"بن لادن لتأجير الآليات", city:"Jeddah",  store:true,  eq:63 },
  { supplierId:"u_288", nEn:"Riyadh Crane Group",      nAr:"مجموعة الرياض للرافعات", city:"Riyadh",  store:false, eq:9  },
  { supplierId:"u_170", nEn:"Eastern Gen Power",       nAr:"الشرقية للطاقة",       city:"Dammam",  store:true,  eq:22 },
  { supplierId:"u_055", nEn:"Tabuk Earthworks",        nAr:"تبوك للأعمال الترابية", city:"Tabuk",   store:false, eq:7  }
];

/* The renter's open requests, for the invitation. */
var REQUESTS = [
  { id:"r1", eqEn:"Excavator 20t",   eqAr:"حفارة 20 طن",  units:5, siteEn:"Qiddiya — Zone 4",     siteAr:"القدية — المنطقة 4",
    start:"2026-09-01", end:"2026-12-31", closes:"2026-09-04", bids:10 },
  { id:"r2", eqEn:"Manlift 16m",     eqAr:"رافعة أفراد 16م", units:4, siteEn:"Diriyah Gate",       siteAr:"بوابة الدرعية",
    start:"2026-09-15", end:"2026-11-30", closes:"2026-09-02", bids:6 },
  { id:"r3", eqEn:"Generator 250 kVA", eqAr:"مولد 250 ك.ف.أ", units:2, siteEn:"Aramco — Dhahran", siteAr:"أرامكو — الظهران",
    start:"2026-09-10", end:"2027-03-10", closes:"2026-09-06", bids:0 }
];

var RENTER = { nEn:"Yara Al-Faraj", nAr:"يارا الفرج", coEn:"Moeda Contracting", coAr:"مويدا للمقاولات",
               email:"yara@moedatech.net" };

/* ══ derived helpers ════════════════════════════════════════════════════════ */
function name(s){ return L(s.nEn, s.nAr); }
function byId(id){ for (var i=0;i<SUPPLIERS.length;i++) if (SUPPLIERS[i].id===id) return SUPPLIERS[i]; return null; }
function req(id){ for (var i=0;i<REQUESTS.length;i++) if (REQUESTS[i].id===id) return REQUESTS[i]; return null; }
function hasEmail(s){ return !!(s.email && s.email.trim()); }
function didBid(s){ return s.activity.bids > 0; }
function allGroups(){
  var seen = {}, out = [];
  SUPPLIERS.forEach(function(s){ s.groups.forEach(function(g){ if (!seen[g]) { seen[g] = 1; out.push(g); } }); });
  return out.sort();
}
function initials(s){
  var w = s.nEn.replace(/[^A-Za-z ]/g, "").trim().split(/\s+/);
  return ((w[0] || "?")[0] + (w[1] ? w[1][0] : "")).toUpperCase();
}

/* ══ view state ═════════════════════════════════════════════════════════════ */
var q = "";
var filter = "all";       /* all | platform | own | vendor | bid | noemail */
var groupFilter = "";
var picked = {};          /* link id → true */

function visible(){
  var needle = q.trim().toLowerCase();
  return SUPPLIERS.filter(function(s){
    if (needle && (s.nEn + " " + s.nAr + " " + (s.contact||"") + " " + (s.email||"") + " " + (s.phone||""))
        .toLowerCase().indexOf(needle) === -1) return false;
    if (groupFilter && s.groups.indexOf(groupFilter) === -1) return false;
    if (filter === "platform") return s.kind === "platform";
    if (filter === "own")      return s.kind === "own";
    if (filter === "vendor")   return s.vendor;
    if (filter === "bid")      return didBid(s);
    if (filter === "noemail")  return !hasEmail(s);
    return true;
  });
}
function pickedList(){ return SUPPLIERS.filter(function(s){ return picked[s.id]; }); }

/* ══ render ═════════════════════════════════════════════════════════════════ */
function render(){
  var rows = visible();
  var vendors = SUPPLIERS.filter(function(s){ return s.vendor; }).length;
  var noMail  = SUPPLIERS.filter(function(s){ return !hasEmail(s); }).length;

  var head =
      '<div class="shead">'
    +   '<span class="plate"><span class="icon" aria-hidden="true">groups</span></span>'
    +   '<span class="txt"><h2>' + L("My Suppliers", "مورّدوني") + '</h2>'
    +     '<span class="sum"><b>' + SUPPLIERS.length + '</b> ' + L("suppliers", "مورّد")
    +       ' · <b>' + vendors + '</b> ' + L("registered vendors", "مورّد معتمد")
    +       (noMail ? ' · <span class="risk">' + noMail + " " + L("with no email", "بدون بريد") + '</span>' : "")
    +     '</span></span>'
    +   '<span class="spacer"></span>'
    +   '<button class="btn btn-secondary" onclick="dlgDirectory()">'
    +     '<span class="icon" aria-hidden="true">travel_explore</span>' + L("Add from Moedatech", "إضافة من مويداتك") + '</button>'
    +   '<button class="btn btn-secondary" onclick="dlgSheet()">'
    +     '<span class="icon" aria-hidden="true">upload_file</span>' + L("Upload sheet", "رفع ملف") + '</button>'
    +   '<button class="btn btn-primary" onclick="dlgSupplierForm(null)">'
    +     '<span class="icon" aria-hidden="true">add</span>' + L("Add supplier", "إضافة مورّد") + '</button>'
    + '</div>';

  document.getElementById("root").innerHTML =
      head
    + suggestedBand()
    + '<div class="panel">'
    +   toolbar(rows.length)
    +   selBar()
    +   (rows.length ? table(rows) : emptyState())
    +   legend()
    + '</div>';
}

function suggestedBand(){
  if (!suggOpen || !SUGGESTED.length) return "";
  return '<div class="sugg">'
    + '<span class="icon" aria-hidden="true">person_add</span>'
    + '<b>' + L("They bid on your requests but are not in your list", "قدّموا عروضاً على طلباتك وليسوا في قائمتك") + '</b>'
    + '<span class="sgrow">'
    +   SUGGESTED.map(function(g){
          return '<span class="sgchip">' + esc(L(g.nEn, g.nAr))
            + ' <span style="color:var(--muted);font-weight:600">' + esc(L(g.why, g.whyAr)) + '</span>'
            + '<button class="add" onclick="acceptSuggestion(\'' + g.key + '\')" '
            +   'title="' + L("Add to my suppliers", "أضف إلى مورّديّ") + '">'
            +   '<span class="icon" aria-hidden="true">add</span></button></span>';
        }).join("")
    + '</span>'
    + '<button class="dismiss" onclick="suggOpen=false;render()">' + L("Dismiss", "إخفاء") + '</button>'
    + '</div>';
}

function toolbar(shown){
  var counts = {
    all: SUPPLIERS.length,
    platform: SUPPLIERS.filter(function(s){ return s.kind === "platform"; }).length,
    own: SUPPLIERS.filter(function(s){ return s.kind === "own"; }).length,
    vendor: SUPPLIERS.filter(function(s){ return s.vendor; }).length,
    bid: SUPPLIERS.filter(didBid).length,
    noemail: SUPPLIERS.filter(function(s){ return !hasEmail(s); }).length
  };
  function chip(key, label, cls){
    return '<button class="fchip' + (cls ? " " + cls : "") + '" aria-pressed="' + (filter === key) + '" '
      + 'onclick="setFilter(\'' + key + '\')">' + label
      + ' <span class="n">' + counts[key] + '</span></button>';
  }
  var groups = allGroups();
  return '<div class="tbar">'
    + '<span class="search"><span class="icon" aria-hidden="true">search</span>'
    +   '<input id="q" value="' + esc(q) + '" oninput="q=this.value;render();refocus()" placeholder="'
    +   L("Search name, contact, email or phone", "ابحث بالاسم أو جهة الاتصال أو البريد أو الهاتف") + '" /></span>'
    + chip("all",      L("All", "الكل"))
    + chip("platform", L("On Moedatech", "على مويداتك"))
    + chip("own",      L("Off platform", "خارج المنصة"))
    + chip("vendor",   L("Registered vendor", "مورّد معتمد"))
    + chip("bid",      L("Bid submitted", "قدّم عرضاً"))
    + (counts.noemail ? chip("noemail", L("No email", "بدون بريد"), "warnish") : "")
    + '<span class="spacer"></span>'
    + (groups.length
        ? '<select class="gsel" onchange="groupFilter=this.value;render()">'
          + '<option value="">' + L("All groups", "كل المجموعات") + '</option>'
          + groups.map(function(g){
              return '<option value="' + esc(g) + '"' + (groupFilter === g ? " selected" : "") + '>' + esc(g) + '</option>';
            }).join("")
          + '</select>'
        : "")
    + '<button class="btn btn-secondary btn-sm" onclick="dlgGroups()">'
    +   '<span class="icon" aria-hidden="true">label</span>' + L("Groups", "المجموعات") + '</button>'
    + '</div>';
}

function selBar(){
  var n = pickedList().length;
  var noMail = pickedList().filter(function(s){ return !hasEmail(s); }).length;
  return '<div class="selbar' + (n ? " on" : "") + '">'
    + '<span class="icon" aria-hidden="true">check_circle</span>'
    + '<span>' + n + " " + L("selected", "محدَّد")
    +   (noMail ? ' · <span style="color:#ffc9c5">' + noMail + " " + L("with no email", "بدون بريد") + '</span>' : "")
    + '</span>'
    + '<span class="spacer"></span>'
    + '<button class="btn btn-secondary btn-sm" onclick="dlgAddToGroup()">'
    +   '<span class="icon" aria-hidden="true">label</span>' + L("Add to group", "إضافة لمجموعة") + '</button>'
    + '<button class="btn btn-primary btn-sm" onclick="dlgInvite()">'
    +   '<span class="icon" aria-hidden="true">mail</span>' + L("Invite to a request", "دعوة إلى طلب") + '</button>'
    + '<button class="clear" onclick="picked={};render()">' + L("Clear", "إلغاء التحديد") + '</button>'
    + '</div>';
}

function table(rows){
  var allPicked = rows.every(function(s){ return picked[s.id]; });
  return '<table><thead><tr>'
    + '<th class="cbox"><input type="checkbox" ' + (allPicked ? "checked" : "") + ' onchange="pickAll(this.checked)" '
    +   'aria-label="' + L("Select all", "تحديد الكل") + '" /></th>'
    + '<th>' + L("Supplier", "المورّد") + '</th>'
    + '<th>' + L("Identity", "الحالة") + '</th>'
    + '<th>' + L("Vendor", "معتمد") + '</th>'
    + '<th>' + L("Contact", "الاتصال") + '</th>'
    + '<th>' + L("Groups", "المجموعات") + '</th>'
    + '<th>' + L("With you", "معك") + '</th>'
    + '<th></th></tr></thead><tbody>'
    + rows.map(row).join("")
    + '</tbody></table>';
}

function row(s){
  var id = s.id;
  return '<tr class="' + (picked[id] ? "picked" : "") + '">'
    + '<td class="cbox"><input type="checkbox" ' + (picked[id] ? "checked" : "") + ' onchange="pickOne(\'' + id + '\',this.checked)" '
    +   'aria-label="' + esc(name(s)) + '" /></td>'

    + '<td><span class="sname">'
    +   '<span class="avatar' + (s.kind === "platform" ? " plat" : "") + '">' + initials(s) + '</span>'
    +   '<span style="min-width:0">'
    +     '<span class="n"><a href="#" onclick="event.preventDefault();dlgSupplier(\'' + id + '\')">' + esc(name(s)) + '</a></span>'
    +     '<span class="c">' + esc(s.contact || L("no contact name", "بدون اسم جهة اتصال")) + '</span>'
    +   '</span></span></td>'

    + '<td><span class="idset">' + idChips(s) + '</span></td>'

    + '<td><button class="vtog" aria-pressed="' + s.vendor + '" onclick="toggleVendor(\'' + id + '\')">'
    +   '<span class="icon" aria-hidden="true">' + (s.vendor ? "verified" : "add") + '</span>'
    +   (s.vendor ? L("Registered", "معتمد") : L("Mark", "تعيين")) + '</button></td>'

    + '<td><span class="contact">'
    +   (hasEmail(s)
        ? '<span class="em">' + esc(s.email) + '</span>'
        : '<span class="missing"><span class="icon" aria-hidden="true">error</span>'
          + L("No email", "بدون بريد") + ' — <button class="addem" onclick="dlgAddEmail(\'' + id + '\')">'
          + L("add", "أضف") + '</button></span>')
    +   '<span class="ph"><span class="num ltr">' + esc(s.phone || "—") + '</span></span>'
    + '</span></td>'

    + '<td><span class="gchips">'
    +   (s.groups.length
        ? s.groups.map(function(g){ return '<span class="gchip">' + esc(g) + '</span>'; }).join("")
        : '<span class="gchip none">' + L("none", "لا شيء") + '</span>')
    + '</span></td>'

    + '<td>' + activityCell(s) + '</td>'

    + '<td><span class="rowacts">'
    +   '<button class="iact" title="' + L("Invite to a request", "دعوة إلى طلب") + '" '
    +     (hasEmail(s) ? 'onclick="inviteOne(\'' + id + '\')"' : "disabled")
    +     '><span class="icon" aria-hidden="true">mail</span></button>'
    +   '<button class="iact" title="' + L("Edit", "تعديل") + '" onclick="dlgSupplierForm(\'' + id + '\')">'
    +     '<span class="icon" aria-hidden="true">edit</span></button>'
    +   '<button class="iact del" title="' + L("Remove", "إزالة") + '" onclick="dlgRemove(\'' + id + '\')">'
    +     '<span class="icon" aria-hidden="true">close</span></button>'
    + '</span></td></tr>';
}

/* The four questions a row must answer, in the order the renter asks them. */
function idChips(s){
  var out = "";
  if (s.kind === "platform") {
    out += '<span class="idchip id-plat"><span class="icon" aria-hidden="true">verified_user</span>'
        +  L("On Moedatech", "على مويداتك") + '</span>';
    if (s.store) out += '<span class="idchip id-store"><span class="icon" aria-hidden="true">storefront</span>'
        +  L("Store", "متجر") + '</span>';
  } else {
    out += '<span class="idchip id-off">' + L("Off platform", "خارج المنصة") + '</span>';
  }
  if (didBid(s)) out += '<span class="idchip id-bid"><span class="icon" aria-hidden="true">gavel</span>'
      + s.activity.bids + " " + (s.activity.bids === 1 ? L("bid", "عرض") : L("bids", "عروض")) + '</span>';
  if (!hasEmail(s)) out += '<span class="idchip id-noemail"><span class="icon" aria-hidden="true">error</span>'
      + L("No email", "بدون بريد") + '</span>';
  return out;
}

function activityCell(s){
  var a = s.activity;
  if (!a.bids && !a.rooms && !a.awards) {
    return '<span class="act none">' + L("nothing yet", "لا شيء بعد") + '</span>';
  }
  var bits = [];
  bits.push('<b class="num">' + a.bids + '</b> <span class="k">' + L("bids", "عروض") + '</span>');
  if (a.rooms)  bits.push('<b class="num">' + a.rooms + '</b> <span class="k">' + L("rooms", "غرف") + '</span>');
  if (a.awards) bits.push('<b class="num">' + a.awards + '</b> <span class="k">' + L("awarded", "ترسية") + '</span>');
  return '<span class="act">' + bits.join(" · ")
    + (a.last ? '<span class="last">' + L("last", "آخر نشاط") + " " + ago(a.last) + '</span>' : "")
    + '</span>';
}

function emptyState(){
  var filtered = SUPPLIERS.length > 0;
  return '<div class="empty"><span class="icon" aria-hidden="true">' + (filtered ? "search_off" : "groups") + '</span>'
    + (filtered
      ? '<b>' + L("No supplier matches", "لا يوجد مورّد مطابق") + '</b>'
        + L("Change the search or the filter.", "غيّر البحث أو التصفية.")
      : '<b>' + L("Your list is empty", "قائمتك فارغة") + '</b>'
        + L("Moedatech has hundreds of suppliers — none of them are here until you add them.",
            "لدى مويداتك مئات المورّدين — لا يظهر أحد هنا حتى تضيفه.")
        + '<div style="margin-top:12px;display:flex;gap:8px;justify-content:center">'
        + '<button class="btn btn-secondary btn-sm" onclick="dlgDirectory()">' + L("Add from Moedatech", "إضافة من مويداتك") + '</button>'
        + '<button class="btn btn-primary btn-sm" onclick="dlgSupplierForm(null)">' + L("Add supplier", "إضافة مورّد") + '</button>'
        + '</div>')
    + '</div>';
}

function legend(){
  return '<div class="legend">'
    + '<span class="li"><span class="idchip id-plat">' + L("On Moedatech", "على مويداتك") + '</span>'
    +   L("has an account with us", "لديه حساب لدينا") + '</span>'
    + '<span class="li"><span class="idchip id-off">' + L("Off platform", "خارج المنصة") + '</span>'
    +   L("you added them", "أضفته أنت") + '</span>'
    + '<span class="li"><span class="idchip id-bid">' + L("Bids", "عروض") + '</span>'
    +   L("bid on your requests", "قدّم عروضاً على طلباتك") + '</span>'
    + '<span class="li"><span class="vtog" aria-pressed="true" style="pointer-events:none">'
    +   '<span class="icon" aria-hidden="true">verified</span>' + L("Registered", "معتمد") + '</span>'
    +   L("your own flag — the supplier never sees it", "علامتك الخاصة — لا يراها المورّد") + '</span>'
    + '</div>';
}

function refocus(){
  var el = document.getElementById("q");
  if (el) { el.focus(); el.setSelectionRange(el.value.length, el.value.length); }
}

/* ══ row actions ════════════════════════════════════════════════════════════ */
function setFilter(f){ filter = f; render(); }
function pickOne(id, on){ if (on) picked[id] = true; else delete picked[id]; render(); }
function pickAll(on){
  visible().forEach(function(s){ if (on) picked[s.id] = true; else delete picked[s.id]; });
  render();
}

/* The flag is written on the link row. Nothing is sent to the supplier, and nothing is written to
   their account — another renter's view of the same supplier does not change. */
function toggleVendor(id){
  var s = byId(id);
  s.vendor = !s.vendor;
  toast(s.vendor
    ? L(name(s) + " is a registered vendor", name(s) + " أصبح مورّداً معتمداً")
    : L(name(s) + " is no longer a registered vendor", name(s) + " لم يعد مورّداً معتمداً"));
  render();
}

function acceptSuggestion(key){
  var g = null;
  for (var i=0;i<SUGGESTED.length;i++) if (SUGGESTED[i].key === key) g = SUGGESTED[i];
  if (!g) return;
  SUPPLIERS.push({
    id:"l" + (SUPPLIERS.length + 1), kind:g.kind, supplierId:g.supplierId || null, store:false,
    nEn:g.nEn, nAr:g.nAr, contact:null, email:g.email, phone:g.phone,
    vendor:false, groups:[], source:g.kind === "platform" ? "platform" : "link_bid",
    activity:{ bids:1, rooms:0, awards:0, last:"2026-08-28", viaLink:true },
    events:[{ icon:"link", t:"Bid submitted through your shared link", s:"—", when:"2026-08-28", go:true }]
  });
  SUGGESTED = SUGGESTED.filter(function(x){ return x.key !== key; });
  toast(L(g.nEn + " added", g.nAr + " تمت الإضافة"));
  render();
}

/* ══ dialogs ════════════════════════════════════════════════════════════════ */
function openModal(html){
  var s = document.getElementById("scrim");
  s.innerHTML = html;
  s.classList.add("open");
  document.body.style.overflow = "hidden";
}
function closeModal(){
  var s = document.getElementById("scrim");
  s.classList.remove("open");
  s.innerHTML = "";
  document.body.style.overflow = "";
}
function mhead(icon, title, sub){
  return '<div class="mhead"><span class="plate"><span class="icon" aria-hidden="true">' + icon + '</span></span>'
    + '<span><h3>' + title + '</h3>' + (sub ? '<span class="sub">' + sub + '</span>' : "") + '</span>'
    + '<button class="x" onclick="closeModal()" aria-label="' + L("Close", "إغلاق") + '">'
    + '<span class="icon" aria-hidden="true">close</span></button></div>';
}
function toast(msg){
  var t = document.getElementById("toast");
  t.innerHTML = '<span class="icon" aria-hidden="true">check_circle</span>' + esc(msg);
  t.classList.add("on");
  clearTimeout(toast._t);
  toast._t = setTimeout(function(){ t.classList.remove("on"); }, 2600);
}

/* ── add from Moedatech ─────────────────────────────────────────────────────
   The directory is Stores' data, read only. A tick writes one link row; it never copies the
   supplier's profile into it. */
var dirPick = {};
function dlgDirectory(){
  dirPick = {};
  openModal('<div class="modal wide">'
    + mhead("travel_explore", L("Add from Moedatech", "إضافة من مويداتك"),
            L("Tick the suppliers you work with. Their name and store stay theirs — you are only adding a link.",
              "اختر المورّدين الذين تتعامل معهم. الاسم والمتجر يبقيان لهم — أنت تضيف ارتباطاً فقط."))
    + '<div class="mbody">'
    +   '<div class="field"><input id="dq" oninput="renderDirectory()" placeholder="'
    +     L("Search the Moedatech directory", "ابحث في دليل مويداتك") + '" /></div>'
    +   '<div id="dlist"></div>'
    + '</div>'
    + '<div class="mfoot"><span class="note" id="dcount"></span><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-primary" onclick="saveDirectory()">' + L("Add selected", "إضافة المحدد") + '</button>'
    + '</div></div>');
  renderDirectory();
}
function renderDirectory(){
  var el = document.getElementById("dq");
  var needle = (el ? el.value : "").trim().toLowerCase();
  var have = {};
  SUPPLIERS.forEach(function(s){ if (s.supplierId) have[s.supplierId] = true; });
  var list = DIRECTORY.filter(function(d){
    return !needle || (d.nEn + " " + d.nAr + " " + d.city).toLowerCase().indexOf(needle) !== -1;
  });
  document.getElementById("dlist").innerHTML = '<div class="plist">' + list.map(function(d){
    var already = have[d.supplierId];
    return '<label class="prow">'
      + '<input type="checkbox" ' + (already ? "disabled" : "")
      +   (dirPick[d.supplierId] ? " checked" : "")
      +   ' onchange="dirPick[\'' + d.supplierId + '\']=this.checked;renderDirectory()" />'
      + '<span class="t"><b>' + esc(L(d.nEn, d.nAr)) + '</b><span>' + esc(d.city)
      +   " · " + d.eq + " " + L("machines", "معدة")
      +   (d.store ? " · " + L("has a store", "لديه متجر") : "") + '</span></span>'
      + (already ? '<span class="have">' + L("in your list", "في قائمتك") + '</span>' : "")
      + '</label>';
  }).join("") + '</div>';
  var n = Object.keys(dirPick).filter(function(k){ return dirPick[k]; }).length;
  document.getElementById("dcount").textContent = n
    ? n + " " + L("selected", "محدَّد")
    : L("Nothing selected yet", "لم يتم التحديد بعد");
}
function saveDirectory(){
  var added = 0;
  DIRECTORY.forEach(function(d){
    if (!dirPick[d.supplierId]) return;
    SUPPLIERS.push({
      id:"l" + (SUPPLIERS.length + 1 + added), kind:"platform", supplierId:d.supplierId, store:d.store,
      nEn:d.nEn, nAr:d.nAr, contact:null, email:null, phone:null,
      vendor:false, groups:[], source:"platform",
      activity:{ bids:0, rooms:0, awards:0, last:null }, events:[]
    });
    added++;
  });
  closeModal();
  toast(added === 1 ? L("1 supplier added", "تمت إضافة مورّد واحد")
                    : L(added + " suppliers added", "تمت إضافة " + added + " مورّدين"));
  render();
}

/* ── add or edit one supplier ───────────────────────────────────────────────
   One of email or phone is required. Email is what an invitation needs, so the form says so
   rather than letting the renter find out at send time. */
function dlgSupplierForm(id){
  var s = id ? byId(id) : null;
  var platform = s && s.kind === "platform";
  openModal('<div class="modal">'
    + mhead(s ? "edit" : "person_add",
            s ? L("Edit supplier", "تعديل مورّد") : L("Add supplier", "إضافة مورّد"),
            platform ? L("Name and store come from their Moedatech account — you can only edit what is yours.",
                         "الاسم والمتجر من حسابهم في مويداتك — يمكنك تعديل ما يخصّك فقط.") : "")
    + '<div class="mbody">'
    +   '<div class="field"><label>' + L("Company name", "اسم الشركة")
    +     (platform ? "" : ' <span class="req">*</span>') + '</label>'
    +     '<input id="f_name" value="' + esc(s ? s.nEn : "") + '" ' + (platform ? "disabled" : "") + ' /></div>'
    +   '<div class="grid2">'
    +     '<div class="field"><label>' + L("Contact name", "اسم جهة الاتصال") + '</label>'
    +       '<input id="f_contact" value="' + esc(s && s.contact ? s.contact : "") + '" /></div>'
    +     '<div class="field"><label>' + L("Email", "البريد الإلكتروني") + '</label>'
    +       '<input id="f_email" type="email" value="' + esc(s && s.email ? s.email : "") + '" />'
    +       '<span class="hint">' + L("Needed to invite them by email.", "مطلوب لدعوتهم بالبريد.") + '</span></div>'
    +   '</div>'
    +   '<div class="field"><label>' + L("Phone", "الهاتف") + '</label>'
    +     '<input id="f_phone" value="' + esc(s && s.phone ? s.phone : "") + '" placeholder="+966 5X XXX XXXX" />'
    +     '<span class="hint">'
    +       L("Also how we recognise them if they already have a Moedatech account.",
             "وهو ما نتعرّف به عليهم إن كان لديهم حساب في مويداتك.") + '</span></div>'
    +   '<div class="note calm"><span class="icon" aria-hidden="true">info</span>'
    +     L("Give at least an email or a phone number.", "أدخل بريداً أو رقم هاتف على الأقل.") + '</div>'
    + '</div>'
    + '<div class="mfoot"><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-primary" onclick="saveSupplier(' + (id ? "'" + id + "'" : "null") + ')">'
    +     L("Save", "حفظ") + '</button>'
    + '</div></div>');
}
function saveSupplier(id){
  var nm = document.getElementById("f_name").value.trim();
  var em = document.getElementById("f_email").value.trim();
  var ph = document.getElementById("f_phone").value.trim();
  var ct = document.getElementById("f_contact").value.trim();
  var s = id ? byId(id) : null;
  if (!s && !nm) { toast(L("A company name is required", "اسم الشركة مطلوب")); return; }
  if (!em && !ph) { toast(L("Give an email or a phone number", "أدخل بريداً أو رقم هاتف")); return; }
  if (s) { if (s.kind !== "platform") { s.nEn = nm; s.nAr = nm; } s.email = em || null; s.phone = ph || null; s.contact = ct || null; }
  else {
    SUPPLIERS.push({ id:"l" + (SUPPLIERS.length + 1), kind:"own", supplierId:null, store:false,
      nEn:nm, nAr:nm, contact:ct || null, email:em || null, phone:ph || null,
      vendor:false, groups:[], source:"manual",
      activity:{ bids:0, rooms:0, awards:0, last:null }, events:[] });
  }
  closeModal();
  toast(id ? L("Saved", "تم الحفظ") : L(nm + " added", nm + " تمت الإضافة"));
  render();
}

function dlgAddEmail(id){
  var s = byId(id);
  openModal('<div class="modal">'
    + mhead("alternate_email", L("Add an email", "إضافة بريد"), esc(name(s)))
    + '<div class="mbody">'
    +   '<div class="note warn"><span class="icon" aria-hidden="true">error</span>'
    +     L("Without an email this supplier is skipped by every invitation.",
             "بدون بريد يتم تخطّي هذا المورّد في كل دعوة.") + '</div>'
    +   '<div class="field"><label>' + L("Email", "البريد الإلكتروني") + '</label>'
    +     '<input id="ae" type="email" placeholder="name@company.com" /></div>'
    + '</div>'
    + '<div class="mfoot"><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-primary" onclick="saveEmail(\'' + id + '\')">' + L("Save", "حفظ") + '</button>'
    + '</div></div>');
}
function saveEmail(id){
  var v = document.getElementById("ae").value.trim();
  if (!v) { toast(L("Enter an email", "أدخل بريداً")); return; }
  byId(id).email = v;
  closeModal(); toast(L("Email added", "تمت إضافة البريد")); render();
}

/* ── the sheet import ───────────────────────────────────────────────────────
   Four fields are ours. Every other column the renter's sheet carries is kept as-is on the row,
   so nothing is lost and no schema is imposed. */
var SHEET_HEADERS = ["Company", "Contact person", "E-mail", "Mobile", "CR number", "Payment terms", "Account manager"];
var SHEET_ROWS = [
  ["Najd Equipment Est.",  "Bandar Al-Qahtani", "sales@najd-eq.sa",  "+966 55 903 1174", "1010445521", "30 days", "Bandar"],
  ["Yanbu Plant Services", "Omar Baghdadi",     "",                  "+966 50 664 2298", "4030118872", "60 days", "Omar"],
  ["Qassim Heavy Lift",    "Saleh Al-Muhaimeed","ops@qhl.com.sa",    "+966 53 771 0925", "1128840033", "30 days", "Saleh"]
];
var sheetMap = { 0:"name", 1:"contact", 2:"email", 3:"phone", 4:"extra", 5:"extra", 6:"extra" };

function dlgSheet(){
  openModal('<div class="modal wide">'
    + mhead("upload_file", L("Upload a supplier sheet", "رفع ملف مورّدين"),
            L("Map your columns to ours. Anything else is kept on the supplier as it is.",
              "طابق أعمدتك مع أعمدتنا. ما عداها يُحفظ كما هو."))
    + '<div class="mbody">'
    +   '<div class="drop"><span class="icon" aria-hidden="true">table_view</span>'
    +     '<b>suppliers-2026.xlsx</b><br />' + SHEET_ROWS.length + " " + L("rows · 7 columns", "صف · 7 أعمدة")
    +     ' — <button style="color:var(--info-deep);font-weight:800" onclick="toast(\''
    +       L("Prototype — file picking is not wired", "نموذج أولي — اختيار الملف غير مفعّل") + '\')">'
    +     L("choose another file", "اختر ملفاً آخر") + '</button></div>'
    +   '<div id="mapwrap"></div>'
    +   '<div><div class="field"><label>' + L("Preview", "معاينة") + '</label></div><div id="prevwrap"></div></div>'
    + '</div>'
    + '<div class="mfoot"><span class="note">'
    +   L("Rows whose phone matches a Moedatech supplier are linked to that account.",
             "الصفوف التي يطابق هاتفها مورّداً في مويداتك تُربط بحسابه.") + '</span>'
    +   '<span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-primary" onclick="saveSheet()">'
    +     L("Import " + SHEET_ROWS.length + " suppliers", "استيراد " + SHEET_ROWS.length + " مورّدين") + '</button>'
    + '</div></div>');
  renderMap();
}
function renderMap(){
  var fields = [
    ["name",    L("Company name", "اسم الشركة")],
    ["contact", L("Contact name", "اسم جهة الاتصال")],
    ["email",   L("Email", "البريد")],
    ["phone",   L("Phone", "الهاتف")],
    ["extra",   L("Keep as extra field", "احتفظ كحقل إضافي")],
    ["skip",    L("Ignore this column", "تجاهل العمود")]
  ];
  document.getElementById("mapwrap").innerHTML =
      '<table class="maptbl"><thead><tr><th>' + L("Your column", "عمودك") + '</th>'
    + '<th>' + L("Sample", "مثال") + '</th><th>' + L("Becomes", "يصبح") + '</th></tr></thead><tbody>'
    + SHEET_HEADERS.map(function(h, i){
        return '<tr><td><b>' + esc(h) + '</b></td>'
          + '<td style="color:var(--muted)">' + esc(SHEET_ROWS[0][i] || "—") + '</td>'
          + '<td><select onchange="sheetMap[' + i + ']=this.value;renderMap();renderPreview()">'
          + fields.map(function(f){
              return '<option value="' + f[0] + '"' + (sheetMap[i] === f[0] ? " selected" : "") + '>' + f[1] + '</option>';
            }).join("")
          + '</select>' + (sheetMap[i] === "extra"
              ? ' <span class="kept">' + L("kept", "محفوظ") + '</span>' : "") + '</td></tr>';
      }).join("")
    + '</tbody></table>';
  renderPreview();
}
function renderPreview(){
  var cols = [];
  SHEET_HEADERS.forEach(function(h, i){ if (sheetMap[i] !== "skip") cols.push(i); });
  document.getElementById("prevwrap").innerHTML =
      '<div class="prev"><table><thead><tr>'
    + cols.map(function(i){ return '<th>' + esc(SHEET_HEADERS[i]) + '</th>'; }).join("")
    + '</tr></thead><tbody>'
    + SHEET_ROWS.map(function(r){
        return '<tr>' + cols.map(function(i){
          var v = r[i];
          return '<td>' + (v ? esc(v)
            : '<span style="color:var(--danger-deep);font-weight:800">' + L("empty", "فارغ") + '</span>') + '</td>';
        }).join("") + '</tr>';
      }).join("")
    + '</tbody></table></div>';
}
function saveSheet(){
  var idx = {}, extras = [];
  SHEET_HEADERS.forEach(function(h, i){
    if (sheetMap[i] === "extra") extras.push(i);
    else if (sheetMap[i] !== "skip") idx[sheetMap[i]] = i;
  });
  var noMail = 0;
  SHEET_ROWS.forEach(function(r, n){
    var extra = {};
    extras.forEach(function(i){ if (r[i]) extra[SHEET_HEADERS[i]] = r[i]; });
    var em = idx.email != null ? r[idx.email] : "";
    if (!em) noMail++;
    SUPPLIERS.push({ id:"s" + (SUPPLIERS.length + 1 + n), kind:"own", supplierId:null, store:false,
      nEn:r[idx.name], nAr:r[idx.name], contact:idx.contact != null ? r[idx.contact] : null,
      email:em || null, phone:idx.phone != null ? r[idx.phone] : null,
      vendor:false, groups:[], source:"sheet", extra:extra,
      activity:{ bids:0, rooms:0, awards:0, last:null }, events:[] });
  });
  closeModal();
  toast(noMail
    ? L(SHEET_ROWS.length + " imported · " + noMail + " with no email",
        "تم استيراد " + SHEET_ROWS.length + " · " + noMail + " بدون بريد")
    : L(SHEET_ROWS.length + " suppliers imported", "تم استيراد " + SHEET_ROWS.length + " مورّدين"));
  render();
}

/* ── groups ─────────────────────────────────────────────────────────────────
   Flat labels. A supplier can carry several, and a group is only ever a way to pick recipients. */
function dlgGroups(){
  var gs = allGroups();
  openModal('<div class="modal">'
    + mhead("label", L("Groups", "المجموعات"),
            L("A group is a way to pick who an invitation goes to.", "المجموعة طريقة لاختيار من تصله الدعوة."))
    + '<div class="mbody">'
    +   (gs.length ? '<div class="plist">' + gs.map(function(g){
          var n = SUPPLIERS.filter(function(s){ return s.groups.indexOf(g) !== -1; }).length;
          var mailed = SUPPLIERS.filter(function(s){ return s.groups.indexOf(g) !== -1 && hasEmail(s); }).length;
          return '<div class="prow"><span class="t"><b>' + esc(g) + '</b><span>'
            + n + " " + L("suppliers", "مورّد")
            + (mailed < n ? ' · <span style="color:var(--danger-deep);font-weight:800">'
                + (n - mailed) + " " + L("with no email", "بدون بريد") + '</span>' : "")
            + '</span></span>'
            + '<button class="btn btn-secondary btn-sm" onclick="inviteGroup(\'' + esc(g) + '\')">'
            +   L("Invite", "دعوة") + '</button>'
            + '<button class="iact del" onclick="deleteGroup(\'' + esc(g) + '\')">'
            +   '<span class="icon" aria-hidden="true">delete</span></button></div>';
        }).join("") + '</div>'
      : '<div class="note calm"><span class="icon" aria-hidden="true">info</span>'
        + L("No groups yet.", "لا توجد مجموعات بعد.") + '</div>')
    +   '<div class="field"><label>' + L("New group", "مجموعة جديدة") + '</label>'
    +     '<input id="ng" placeholder="' + L("Earthmoving, Riyadh, Preferred…", "أعمال ترابية، الرياض، مفضّل…") + '" /></div>'
    + '</div>'
    + '<div class="mfoot"><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Done", "تم") + '</button>'
    +   '<button class="btn btn-primary" onclick="createGroup()">' + L("Create", "إنشاء") + '</button>'
    + '</div></div>');
}
function createGroup(){
  var v = document.getElementById("ng").value.trim();
  if (!v) { toast(L("Name the group", "سمِّ المجموعة")); return; }
  /* A group with no member does not exist on its own — the renter picks members next. */
  closeModal();
  picked = {};
  dlgAddToGroup(v);
}
function deleteGroup(g){
  SUPPLIERS.forEach(function(s){ s.groups = s.groups.filter(function(x){ return x !== g; }); });
  if (groupFilter === g) groupFilter = "";
  toast(L("Group removed", "تم حذف المجموعة"));
  dlgGroups(); render();
}
function dlgAddToGroup(preset){
  var gs = allGroups();
  var sel = pickedList();
  openModal('<div class="modal">'
    + mhead("label", L("Add to a group", "إضافة لمجموعة"),
            sel.length ? sel.length + " " + L("suppliers selected", "مورّد محدَّد")
                       : L("Pick the members", "اختر الأعضاء"))
    + '<div class="mbody">'
    +   '<div class="field"><label>' + L("Group", "المجموعة") + '</label>'
    +     '<input id="gname" value="' + esc(preset || "") + '" list="glist" placeholder="'
    +       L("Type a name or pick one", "اكتب اسماً أو اختر") + '" />'
    +     '<datalist id="glist">' + gs.map(function(g){ return '<option value="' + esc(g) + '"></option>'; }).join("") + '</datalist></div>'
    +   (sel.length
        ? '<div class="note calm"><span class="icon" aria-hidden="true">group</span>'
          + esc(sel.map(name).join(", ")) + '</div>'
        : '<div class="plist">' + SUPPLIERS.map(function(s){
            return '<label class="prow"><input type="checkbox" onchange="picked[\'' + s.id + '\']=this.checked" />'
              + '<span class="t"><b>' + esc(name(s)) + '</b><span>'
              + esc(s.groups.join(", ") || L("no group", "بلا مجموعة")) + '</span></span></label>';
          }).join("") + '</div>')
    + '</div>'
    + '<div class="mfoot"><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-primary" onclick="saveGroup()">' + L("Add", "إضافة") + '</button>'
    + '</div></div>');
}
function saveGroup(){
  var g = document.getElementById("gname").value.trim();
  if (!g) { toast(L("Name the group", "سمِّ المجموعة")); return; }
  var members = pickedList();
  if (!members.length) { toast(L("Pick at least one supplier", "اختر مورّداً واحداً على الأقل")); return; }
  members.forEach(function(s){ if (s.groups.indexOf(g) === -1) s.groups.push(g); });
  closeModal(); picked = {};
  toast(L(members.length + " added to " + g, "تمت إضافة " + members.length + " إلى " + g));
  render();
}

function dlgRemove(id){
  var s = byId(id);
  openModal('<div class="modal">'
    + mhead("delete", L("Remove from my suppliers", "إزالة من مورّديّ"), esc(name(s)))
    + '<div class="mbody"><div class="note calm"><span class="icon" aria-hidden="true">info</span>'
    +   L("This removes your link, your vendor flag and your groups. Their Moedatech account, their store and the bids they already sent you are untouched.",
         "هذا يزيل ارتباطك وعلامتك ومجموعاتك. حسابهم في مويداتك ومتجرهم والعروض التي أرسلوها لا تتأثر.")
    + '</div></div>'
    + '<div class="mfoot"><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-danger" onclick="doRemove(\'' + id + '\')">' + L("Remove", "إزالة") + '</button>'
    + '</div></div>');
}
function doRemove(id){
  SUPPLIERS = SUPPLIERS.filter(function(s){ return s.id !== id; });
  delete picked[id];
  closeModal(); toast(L("Removed", "تمت الإزالة")); render();
}

/* ── the supplier sheet ─────────────────────────────────────────────────────
   Everything here is the renter's own history with this supplier. None of it is stored on the link
   row: it is read from the bids, the deal rooms and the awards the app already holds. */
function dlgSupplier(id){
  var s = byId(id);
  var a = s.activity;
  openModal('<div class="modal wide">'
    + mhead(s.kind === "platform" ? "verified_user" : "person", esc(name(s)),
            esc((s.contact ? s.contact + " · " : "")
              + (s.kind === "platform" ? L("Moedatech supplier", "مورّد في مويداتك")
                                       : L("added by you", "أضفته أنت"))))
    + '<div class="mbody">'
    +   '<div class="idset">' + idChips(s)
    +     '<button class="vtog" aria-pressed="' + s.vendor + '" onclick="toggleVendor(\'' + id + '\');dlgSupplier(\'' + id + '\')">'
    +       '<span class="icon" aria-hidden="true">' + (s.vendor ? "verified" : "add") + '</span>'
    +       (s.vendor ? L("Registered vendor", "مورّد معتمد") : L("Mark as registered vendor", "تعيين كمورّد معتمد"))
    +     '</button></div>'

    +   '<div class="kpis">'
    +     '<div class="kpi"><b>' + a.bids   + '</b><span>' + L("bids received", "عروض واردة") + '</span></div>'
    +     '<div class="kpi"><b>' + a.rooms  + '</b><span>' + L("deal rooms", "غرف تفاوض") + '</span></div>'
    +     '<div class="kpi"><b>' + a.awards + '</b><span>' + L("awards", "ترسيات") + '</span></div>'
    +     '<div class="kpi"><b class="words">' + (a.last ? ago(a.last) : "—") + '</b><span>' + L("last activity", "آخر نشاط") + '</span></div>'
    +   '</div>'

    +   '<div class="field"><label>' + L("Contact", "الاتصال") + '</label>'
    +     '<div class="note calm"><span class="icon" aria-hidden="true">contact_mail</span><span>'
    +       (hasEmail(s) ? esc(s.email)
                        : '<b style="color:var(--danger-deep)">' + L("No email — invitations skip them", "بدون بريد — تتخطاه الدعوات") + '</b>')
    +       '<br /><span class="num ltr">' + esc(s.phone || "—") + '</span></span></div></div>'

    +   (s.extra ? '<div class="field"><label>' + L("From your sheet", "من ملفك") + '</label><div class="xtra">'
        + Object.keys(s.extra).map(function(k){
            return '<span class="x"><span class="k">' + esc(k) + '</span><span>' + esc(s.extra[k]) + '</span></span>';
          }).join("") + '</div></div>' : "")

    +   '<div class="field"><label>' + L("History with you", "سجلّك معه") + '</label>'
    +     (s.events.length
          ? '<div class="tl">' + s.events.map(function(e){
              return '<div class="tlrow"><span class="dot"><span class="icon" aria-hidden="true">' + e.icon + '</span></span>'
                + '<span class="t"><b>' + esc(L(e.t, e.t)) + '</b><span>' + esc(e.s) + '</span></span>'
                + (e.go ? '<button class="go" onclick="toast(\''
                    + L("Opens the bid in Requests", "يفتح العرض في الطلبات") + '\')">'
                    + L("View", "عرض") + '</button>' : "")
                + '<span class="when">' + ago(e.when) + '</span></div>';
            }).join("") + '</div>'
          : '<div class="note calm"><span class="icon" aria-hidden="true">history</span>'
            + L("Nothing yet — no bid, no deal room, no award.", "لا شيء بعد — لا عرض ولا غرفة ولا ترسية.") + '</div>')
    +   '</div>'
    + '</div>'
    + '<div class="mfoot">'
    +   '<button class="btn btn-ghost" onclick="dlgSupplierForm(\'' + id + '\')">'
    +     '<span class="icon" aria-hidden="true">edit</span>' + L("Edit", "تعديل") + '</button>'
    +   '<span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Close", "إغلاق") + '</button>'
    +   '<button class="btn btn-primary" ' + (hasEmail(s) ? 'onclick="inviteOne(\'' + id + '\')"' : "disabled") + '>'
    +     '<span class="icon" aria-hidden="true">mail</span>' + L("Invite to a request", "دعوة إلى طلب") + '</button>'
    + '</div></div>');
}

/* ══ the invitation ═════════════════════════════════════════════════════════
   One request, a list of recipients, one email sent by Moedatech on the renter's behalf with the
   renter as reply-to. Everything the recipient sees is the link the app already produces — the
   preview card is what src/app/bid/[token]/og already renders for WhatsApp, Apple Mail, Outlook
   and Slack.

   The one hard rule: no email address, no invitation. The dialog says who is being skipped BEFORE
   the send, and every skipped supplier can be fixed inline. */
var invSel = {};   /* link id → true */
var invReq = "r1";
var invNote = "";

function inviteOne(id){ picked = {}; picked[id] = true; dlgInvite(); }
function inviteGroup(g){
  picked = {};
  SUPPLIERS.forEach(function(s){ if (s.groups.indexOf(g) !== -1) picked[s.id] = true; });
  dlgInvite();
}
function dlgInvite(){
  invSel = {};
  var seed = pickedList();
  if (!seed.length) seed = SUPPLIERS.filter(function(s){ return s.vendor; });
  seed.forEach(function(s){ invSel[s.id] = true; });
  openModal('<div class="modal wide">'
    + mhead("mail", L("Invite suppliers to bid", "دعوة مورّدين لتقديم عروض"),
            L("One email, sent by Moedatech, with you as the reply-to address.",
              "بريد واحد يُرسل من مويداتك، والردود تصلك أنت."))
    + '<div class="mbody" id="invbody"></div>'
    + '<div class="mfoot"><span class="note" id="invcount"></span><span class="spacer"></span>'
    +   '<button class="btn btn-ghost" onclick="closeModal()">' + L("Cancel", "إلغاء") + '</button>'
    +   '<button class="btn btn-primary" id="invsend" onclick="sendInvite()">'
    +     '<span class="icon" aria-hidden="true">send</span><span id="invsendtxt"></span></button>'
    + '</div></div>');
  renderInvite();
}
function renderInvite(){
  var r = req(invReq);
  var chosen  = SUPPLIERS.filter(function(s){ return invSel[s.id]; });
  var sendable = chosen.filter(hasEmail);
  var skipped  = chosen.filter(function(s){ return !hasEmail(s); });
  var groups = allGroups();

  document.getElementById("invbody").innerHTML =
      '<div class="field"><label>' + L("Request", "الطلب") + '</label>'
    +   '<select onchange="invReq=this.value;renderInvite()">'
    +     REQUESTS.map(function(x){
            return '<option value="' + x.id + '"' + (invReq === x.id ? " selected" : "") + '>'
              + esc(L(x.eqEn, x.eqAr)) + " ×" + x.units + " — " + esc(L(x.siteEn, x.siteAr)) + '</option>';
          }).join("")
    +   '</select></div>'

    + '<div class="field"><label>' + L("Recipients", "المستلمون") + '</label>'
    +   '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px">'
    +     '<button class="fchip" onclick="invAll()">' + L("All registered vendors", "كل المورّدين المعتمدين") + '</button>'
    +     groups.map(function(g){
            return '<button class="fchip" onclick="invGroup(\'' + esc(g) + '\')">' + esc(g) + '</button>';
          }).join("")
    +     '<button class="fchip" onclick="invSel={};renderInvite()">' + L("None", "لا أحد") + '</button>'
    +   '</div>'
    +   '<div class="plist">' + SUPPLIERS.map(function(s){
          return '<label class="prow"><input type="checkbox" ' + (invSel[s.id] ? "checked" : "")
            + ' onchange="invSel[\'' + s.id + '\']=this.checked;renderInvite()" />'
            + '<span class="t"><b>' + esc(name(s)) + '</b><span>'
            + (hasEmail(s) ? esc(s.email)
                : '<span style="color:var(--danger-deep);font-weight:800">' + L("no email", "بدون بريد") + '</span>')
            + (s.groups.length ? " · " + esc(s.groups.join(", ")) : "") + '</span></span>'
            + (hasEmail(s) ? "" : '<button class="btn btn-secondary btn-sm" onclick="event.preventDefault();dlgAddEmail(\''
                + s.id + '\')">' + L("Add email", "أضف بريداً") + '</button>')
            + '</label>';
        }).join("") + '</div></div>'

    + (skipped.length
      ? '<div class="note warn"><span class="icon" aria-hidden="true">error</span><span><b>'
        + skipped.length + " " + L("will be skipped — no email address", "سيتم تخطّيهم — بلا بريد") + '</b><br />'
        + esc(skipped.map(name).join(", ")) + '</span></div>'
      : "")

    + '<div class="field"><label>' + L("A line of your own", "سطر منك") + '</label>'
    +   '<textarea rows="2" oninput="invNote=this.value" placeholder="'
    +     L("Optional — added above the request details.", "اختياري — يُضاف فوق تفاصيل الطلب.") + '">'
    +   esc(invNote) + '</textarea></div>'

    + '<div class="field"><label>' + L("What they receive", "ما سيصلهم") + '</label>' + mailPreview(r, sendable) + '</div>';

  document.getElementById("invcount").innerHTML = sendable.length
    ? sendable.length + " " + L("recipients", "مستلم")
      + (skipped.length ? ' · <span style="color:var(--danger-deep);font-weight:800">' + skipped.length + " "
          + L("skipped", "متخطّى") + '</span>' : "")
    : L("Pick at least one supplier with an email", "اختر مورّداً واحداً لديه بريد");
  document.getElementById("invsendtxt").textContent = sendable.length
    ? L("Send to " + sendable.length, "إرسال إلى " + sendable.length)
    : L("Send", "إرسال");
  document.getElementById("invsend").disabled = sendable.length === 0;
}
function invAll(){
  invSel = {};
  SUPPLIERS.forEach(function(s){ if (s.vendor) invSel[s.id] = true; });
  renderInvite();
}
function invGroup(g){
  invSel = {};
  SUPPLIERS.forEach(function(s){ if (s.groups.indexOf(g) !== -1) invSel[s.id] = true; });
  renderInvite();
}

function mailPreview(r, sendable){
  var co = L(RENTER.coEn, RENTER.coAr);
  var subject = L(co + " invites you to bid — " + r.eqEn + ", " + r.siteEn,
                  co + " يدعوك لتقديم عرض — " + r.eqAr + "، " + r.siteAr);
  var to = sendable.length
    ? (sendable.length <= 2
        ? sendable.map(function(s){ return s.email; }).join(", ")
        : sendable[0].email + " " + L("and " + (sendable.length - 1) + " more", "و" + (sendable.length - 1) + " آخرين"))
    : "—";
  return '<div class="mail">'
    + '<div class="mailhead">'
    +   '<div class="l"><span class="k">' + L("From", "من") + '</span><span class="v">Moedatech &lt;rfq@moedatech.net&gt;</span></div>'
    +   '<div class="l"><span class="k">' + L("Reply to", "الرد إلى") + '</span><span class="v">' + esc(RENTER.email) + '</span></div>'
    +   '<div class="l"><span class="k">' + L("To", "إلى") + '</span><span class="v">' + esc(to) + '</span></div>'
    +   '<div class="l"><span class="k">' + L("Subject", "الموضوع") + '</span><span class="v">' + esc(subject) + '</span></div>'
    + '</div>'
    + '<div class="mailbody">'
    +   '<div>' + L("Hello,", "مرحباً،") + '</div>'
    +   (invNote ? '<div>' + esc(invNote) + '</div>' : "")
    +   '<div>' + L(co + " is asking for a quotation on the request below. Open the link, fill in your price and terms, and submit — no account needed.",
                    co + " يطلب عرض سعر على الطلب أدناه. افتح الرابط وأدخل السعر والشروط وأرسل — بدون حساب.") + '</div>'
    +   linkCard(r)
    +   '<div><span class="cta">' + L("Submit your bid", "قدّم عرضك") + '</span></div>'
    +   '<div style="color:var(--muted)">' + L("Bidding closes " + fmtDate(r.closes) + ".",
                                               "يغلق استقبال العروض في " + fmtDate(r.closes) + ".") + '</div>'
    + '</div></div>';
}
/* The card the link itself unfurls into. Already live — the app builds it in
   src/app/bid/[token]/page.tsx and renders the image in that route's `og`. */
function linkCard(r){
  return '<div class="lcard">'
    + '<div class="top"><span class="plate"><span class="icon" aria-hidden="true">handyman</span></span>'
    +   '<span><b>' + esc(L(r.eqEn, r.eqAr)) + " ×" + r.units + '</b>'
    +   '<span>' + L("Request for quotation · Moedatech", "طلب عرض سعر · مويداتك") + '</span></span></div>'
    + '<div class="rows">'
    +   '<span class="r"><span class="k">' + L("Site", "الموقع") + '</span><span class="v">' + esc(L(r.siteEn, r.siteAr)) + '</span></span>'
    +   '<span class="r"><span class="k">' + L("Rental period", "فترة الإيجار") + '</span><span class="v num">'
    +     fmtDate(r.start) + " → " + fmtDate(r.end) + '</span></span>'
    +   '<span class="r"><span class="k">' + L("Units", "العدد") + '</span><span class="v num">' + r.units + '</span></span>'
    +   '<span class="r"><span class="k">' + L("Requested by", "الطالب") + '</span><span class="v">'
    +     esc(L(RENTER.coEn, RENTER.coAr)) + '</span></span>'
    + '</div>'
    + '<div class="foot">web.moedatech.net/bid/…</div></div>';
}
function fmtDate(iso){
  var d = new Date(iso);
  var m = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][d.getMonth()];
  var mAr = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"][d.getMonth()];
  return d.getDate() + " " + L(m, mAr) + " " + d.getFullYear();
}

function sendInvite(){
  var chosen = SUPPLIERS.filter(function(s){ return invSel[s.id]; });
  var sendable = chosen.filter(hasEmail);
  var skipped  = chosen.filter(function(s){ return !hasEmail(s); });
  var r = req(invReq);
  /* The send is recorded per recipient, which is what lets the request show invited / opened / bid
     later on. That is the reason it goes through our server rather than the renter's mail client. */
  sendable.forEach(function(s){
    s.events.unshift({ icon:"mail", t:"Invited by email", s:L(r.eqEn, r.eqAr) + " — " + L("sent", "أُرسل"),
                       when:"2026-08-31" });
  });
  closeModal();
  picked = {};
  openModal('<div class="modal">'
    + mhead("mark_email_read", L("Invitation sent", "تم إرسال الدعوة"),
            esc(L(r.eqEn, r.eqAr) + " — " + L(r.siteEn, r.siteAr)))
    + '<div class="mbody">'
    +   '<div class="note info"><span class="icon" aria-hidden="true">check_circle</span><span><b>'
    +     sendable.length + " " + L("emails sent", "بريد أُرسل") + '</b><br />'
    +     esc(sendable.map(name).join(", ")) + '</span></div>'
    +   (skipped.length
        ? '<div class="note warn"><span class="icon" aria-hidden="true">error</span><span><b>'
          + skipped.length + " " + L("skipped — no email", "متخطّى — بلا بريد") + '</b><br />'
          + esc(skipped.map(name).join(", ")) + '</span></div>'
        : "")
    +   '<div class="note calm"><span class="icon" aria-hidden="true">visibility</span>'
    +     L("You will see who opened the link and who bid on the request itself.",
             "سترى من فتح الرابط ومن قدّم عرضاً في الطلب نفسه.") + '</div>'
    + '</div>'
    + '<div class="mfoot"><span class="spacer"></span>'
    +   '<button class="btn btn-primary" onclick="closeModal()">' + L("Done", "تم") + '</button>'
    + '</div></div>');
  render();
}

document.addEventListener("keydown", function(e){ if (e.key === "Escape") closeModal(); });
render();
</script>
</body>
</html>
