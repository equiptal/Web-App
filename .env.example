# Web-App (renter RFQ creation) — environment variables.
#
# Local dev:  copy this file to `.env.local` (gitignored) and fill in values.
# Staging/prod: set these in the AWS Amplify console → App settings → Environment variables
#               (per branch). NEVER commit real values.
#
# All variables are SERVER-SIDE (no NEXT_PUBLIC_ prefix) on purpose: the app's /api routes act as a
# secure relay so the access token never reaches the browser. When a service's variable is unset,
# the app falls back to the built-in stand-in mock for that service (so staging still runs).

# --- Mansour: the normalization agent (RFQ parsing) ------------------------------------
# Base URL of the deployed Normalization-Agent HTTP service. The relay POSTs to /rfq/normalize.
# Leave blank to use stand-in mock parsing (recommended while Mansour's contract is still in flux).
MANSOUR_URL=
# Shared secret for Mansour's /rfq/* + /normalize surface. SECRET — server-side only.
# SEPARATE from BIDS_API_TOKEN (Mansour gates the two surfaces independently; a crossed pair 401s).
# Set this — and rebuild the Amplify branch, env is baked at build time — BEFORE the agent enables
# its own MANSOUR_API_TOKEN. Blank = sent as no header, which is today's behaviour.
MANSOUR_API_TOKEN=

# --- Moedatech app "agents-backend": equipment taxonomy + request submission -----------
# Base URL of the app's agents-backend. Staging (per integration handoff):
#   https://kge3xspt36.execute-api.eu-central-1.amazonaws.com
# The relay calls GET /agents/taxonomy and POST /agents/requests. Leave blank to use the mock.
AGENTS_API_URL=

# Bearer token for AGENTS_API_URL (the backend's ADMIN_OUTREACH_TOKEN). SECRET.
# Required whenever AGENTS_API_URL is set. Never commit this.
AGENTS_API_TOKEN=

# Test rentee user id used as the submitter while web auth (web-app/001) is bypassed.
# create_request requires a userId. Without this, submission stays on the mock even if the URL+token
# are set. Use a known staging rentee id.
AGENTS_TEST_USER_ID=

# --- Moedatech-App backend: web auth (web-app/001) + stores/taxonomy/master-data --------
# Base URL of the main app backend — the same Cognito-backed phone+OTP /auth/* the mobile app uses,
# plus /stores, /public/stores, /equipment/taxonomy and /master-data/*.
# Staging: https://c4tupvmckc.execute-api.eu-central-1.amazonaws.com
# NOT optional and has NO mock: leaving it blank makes the auth routes return 500 (not_configured)
# and the public store directory return 503 (offline).
APP_API_URL=

# Multi-tenancy header (X-Tenant-Id) sent on every app-backend call. Defaults to "default".
TENANT_ID=

NEXT_PUBLIC_STREAM_API_KEY=

# ── Intercom (support messenger) ───────────────────────────────────────────────────────────────────
# The workspace's app id. NOT a secret — it ships inside the messenger snippet on every page that
# loads it, which is why the mobile app hardcodes the same value. Set this only to point a staging
# build at a different workspace; unset, the web uses the production workspace the app already uses,
# so a support reply reaches the same inbox from either client.
NEXT_PUBLIC_INTERCOM_APP_ID=w17eryax

# Intercom identity verification. OPTIONAL, and unset on purpose — the web follows the app, and the
# app signs nothing: `loginIdentifiedUser` sends no hash. One client must not describe a person
# differently from the other.
#
# THE DASHBOARD IS WHAT MATTERS. Identity Verification is a per-platform switch under Intercom →
# Settings → Security, and it must be OFF for WEB. Switched on with no secret here, the workspace
# answers every identified boot with a 403 on `/messenger/web/ping` and the messenger reads
# «Something's gone wrong — content could not be loaded» for every signed-in renter. That is what it
# was doing until 2026-08-28. Nothing in the client can detect or recover from it: no callback fires,
# and a refused boot leaves the same two nodes behind that a healthy unopened messenger does.
#
# Set this only if you also switch verification ON for web. Then /api/support/intercom signs the boot
# and the two settings agree. Either way is fine; disagreeing is what breaks it.
INTERCOM_IDENTITY_SECRET=
# --- Off-catalogue equipment (custom_equipment_request) --------------------------------
# NEXT_PUBLIC_CUSTOM_EQUIPMENT=1 lets a renter NAME a machine the catalogue cannot place and post the
# request with it (no taxonomy ids, `customEquipmentName` instead). Leave unset until the backend
# half is deployed — `POST /agents/requests` 422s an item with no ids until then. Build-time, like
# every NEXT_PUBLIC_ variable: rebuild the Amplify branch after changing it.
NEXT_PUBLIC_CUSTOM_EQUIPMENT=
