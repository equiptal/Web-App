# Web-App (renter RFQ creation) — environment variables.
#
# Local dev:  copy this file to `.env.local` (gitignored) and fill in values.
# Staging/prod: set these in the AWS Amplify console → App settings → Environment variables
#               (per branch). NEVER commit real values.
#
# All variables are SERVER-SIDE (no NEXT_PUBLIC_ prefix) on purpose: the app's /api routes act as a
# secure relay so the access token never reaches the browser. When a service's variable is unset,
# the app falls back to the built-in stand-in mock for that service (so staging still runs).

# --- Mansour: the normalization agent (RFQ parsing) ------------------------------------
# Base URL of the deployed Normalization-Agent HTTP service. The relay POSTs to /rfq/normalize.
# Leave blank to use stand-in mock parsing (recommended while Mansour's contract is still in flux).
MANSOUR_URL=

# --- Moedatech app "agents-backend": equipment taxonomy + request submission -----------
# Base URL of the app's agents-backend. Staging (per integration handoff):
#   https://kge3xspt36.execute-api.eu-central-1.amazonaws.com
# The relay calls GET /agents/taxonomy and POST /agents/requests. Leave blank to use the mock.
AGENTS_API_URL=

# Bearer token for AGENTS_API_URL (the backend's ADMIN_OUTREACH_TOKEN). SECRET.
# Required whenever AGENTS_API_URL is set. Never commit this.
AGENTS_API_TOKEN=

# Test rentee user id used as the submitter while web auth (web-app/001) is bypassed.
# create_request requires a userId. Without this, submission stays on the mock even if the URL+token
# are set. Use a known staging rentee id.
AGENTS_TEST_USER_ID=

NEXT_PUBLIC_STREAM_API_KEY=
