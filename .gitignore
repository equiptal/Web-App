# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable (design tooling) — machine-local overrides
.impeccable/config.local.json
.impeccable/live/
.impeccable/*cache*

# Editor/agent backups — never tracked. One was swept in by a `git add -A` on 2026-08-31.
*.bak

# UI screenshots from `npm run ui:shots` — evidence for a change report, never committed
.artifacts/

# The screenshot lane's own build dir — it must not contend with `.next` (see next.config.ts)
.next-preview/

# Typecheck/build probe dirs written by ad-hoc `next build` runs — never committed.
# A GLOB, not a list: `.next-probe3/` was created on 2026-09-12 and the two named rules above it
# did not cover it, so a whole build tree sat untracked in `git status` waiting for a `git add -A`.
.next-probe*/
